POSTGRES_DSN=postgresql+asyncpg://ltc:<請填入密碼>@localhost:5432/ltc_rag
# 資料與系統分開：資料一律放在 repo 外的資料根目錄（/srv/ltc-data），請用絕對路徑
CHROMADB_PERSIST_DIR=/srv/ltc-data/chromadb
REDIS_URL=redis://localhost:6379/0
OLLAMA_BASE_URL=http://localhost:11434
# 本機已預先 pull 繁中政府用語調校過的 TAIDE 模型，比通用 llama3.1 更適合長照法規領域
OLLAMA_MODEL=hf.co/tetf/Llama-3.1-TAIDE-LX-8B-Chat-GGUF:Q4_K_M
LTC_POINTS_CSV_URL=https://ltcpap.mohw.gov.tw/publish/abc.csv
LAW_API_BASE_URL=https://law.moj.gov.tw/api
EVIDENCE_SIMILARITY_THRESHOLD=0.55
FAITHFULNESS_CITATION_OVERLAP_THRESHOLD=0.4
OPEN_WEBUI_BASE_URL=http://localhost:8080
# 需要 Open WebUI 管理員帳號在 Settings > Account > API Keys 產生，供 ingestion/sync_feedback.py 使用
OPEN_WEBUI_API_KEY=

# 小照 LINE 化階段 2（見 docs/designs/2026-10-12-xiaozhao-phase2-line-channel.md）
# 需要 LINE Developers Console 申請 Messaging API channel 後取得，尚未設定前 /v1/line/webhook 會直接拒絕請求
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_API_BASE_URL=https://api.line.me
WAKE_WORD_SESSION_WINDOW_SECONDS=180

# 探索性 spike 用（scripts/smoke_test_services.py），僅本機開發，請在 .env 填實際值，不要提交
POSTGRES_USER=ltc
POSTGRES_PASSWORD=
POSTGRES_DB=ltc_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
ELASTIC_URL=https://localhost:9200
ELASTIC_USER=elastic
ELASTIC_PASSWORD=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

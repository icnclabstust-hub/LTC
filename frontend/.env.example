# LINE Bot spike 設定範本（docs/designs/2026-10-05-ltc-awe-linebot-asr-spike.md）
# 複製成 .env 後填入實際值；.env 已列入 .gitignore，不會被 commit。

# Developers Console > Basic settings > Channel secret
LINE_CHANNEL_SECRET=

# Developers Console > Messaging API > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# Developers Console > Basic settings > Your user ID（多個以逗號分隔，例：本人,同學）
LINE_ALLOWED_USER_IDS=

# ngrok 固定網域（非秘密；ngrok 後台 > Domains），不含 https://
NGROK_DOMAIN=

# 小照網頁（LIFF）：Developers Console > LINE Login channel（非秘密，會出現在網頁前端）
# Basic settings > Channel ID
LINE_LOGIN_CHANNEL_ID=
# LIFF 分頁 > LIFF ID（網址為 https://liff.line.me/<LIFF_ID>）
LIFF_ID=

# 小照服務（docs/designs/2026-10-08-ltc-awe-liff-recording-and-line-cases.md）
# 管理員的 LINE userId（多個以逗號分隔）；只有這些帳號能發綁定碼、切換身分
LINE_ADMIN_USER_IDS=
# 後端：mock（模擬）或 http（依後端組 API 合約 ①②③ 串接，2026-10-14 http-backend）
BACKEND_MODE=mock
# http 模式：後端網址、權杖（只放 .env，不進版控）、輪詢間隔與逾時（秒）
BACKEND_URL=
BACKEND_TOKEN=
BACKEND_POLL_SECONDS=0.1
# 最長等待（秒），逾時轉督導；回覆目標另見 REPLY_TARGET_SECONDS
BACKEND_TIMEOUT_SECONDS=30
# http 模式時後端呼叫在背景執行，不卡住錄音與 LINE webhook（2026-10-14）；設 0 恢復同步
BACKEND_ASYNC=1
BACKEND_WORKERS=4
# 回覆目標（秒）：打字或語音提問送出後超過此時間還沒回覆，先顯示／回覆「小照還在查詢」，回答到了再補上
REPLY_TARGET_SECONDS=3
# 一輪紀錄（/v1/scene）是否附逐字稿；後端組原設計不含原文，待確認；設 0 不送文字
BACKEND_SCENE_TEXT=1
# 送給後端的 JSON 與回應寫入 xiaozhao_data/backend_requests-YYYYMMDD.jsonl 並印在終端機（測試用，保存 1 天）；設 0 關閉
BACKEND_LOG=1
# 預取門檻：暫定 0.9，須以交叉驗證資料訂定（cache-strategy 第 4 節）
PREFETCH_THRESHOLD=0.9
# 切句／切輪門檻：fixed（固定 0.5／3 秒）、adaptive（依說話人語速調整，2026-10-12 spike）、
# pause_veto（停頓 0.5 秒切句，但前句沒說完時不切，2026-10-13）
ENDPOINT_MODE=fixed
# 片段中間的「小照你好」「小照請回答」依位置切輪（2026-10-13）；設 0 恢復以整個片段處理
KEYWORD_SPLIT=1
# 輪內音訊存到伺服器（xiaozhao_data/turn_audio/）只供督導回聽；督導確認即刪、最長 7 天；設 0 不保存任何音訊
KEEP_TURN_AUDIO=1
# 外接麥克風音量偏小時，伺服器自動放大到手機的水準（只放大、最多 24 dB，2026-10-14）；設 0 關閉
AUTO_GAIN=1
# 以問句為單位切句：問句單獨一句，問句附同一段的相關陳述送後端（2026-10-14）；設 0 恢復原本的切句
QUESTION_WINDOW=1
# 後端抓取已確認紀錄的權杖（只給後端組；留空即關閉匯出 API）。產生方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
EXPORT_TOKEN=
# 意圖模型（預設 exported_bert_care7/A1_s42/model）
# 意圖模型：n0（雙輸出頭，輸入「說話人：句子」，2026-10-14）或 a1（回滾用）；N0 模型不存在時自動改用 A1
INTENT_MODEL=n0
# N0_MODEL_DIR=（預設 exported_ctx_care7/N0_s42/model）
# INTENT_MODEL_DIR=
# 本機測試登入（?dev=<userId>），只接受直接連 127.0.0.1 的請求；正式測試請留空
# XIAOZHAO_DEV_FAKE_AUTH=
